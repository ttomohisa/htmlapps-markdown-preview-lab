{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "slug",
    "version",
    "repository",
    "build"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nameJa": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "descriptionJa": {
      "type": "string"
    },
    "defaultLanguage": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "output",
        "blockRuntimeNetwork"
      ],
      "properties": {
        "output": {
          "type": "string"
        },
        "blockRuntimeNetwork": {
          "type": "boolean"
        },
        "selfExtract": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "output": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
